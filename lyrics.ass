Dialogue: 0,0:00:29.80,0:00:31.03,Default,,0,0,0,,FONSI,
Dialogue: 0,0:00:31.36,0:00:32.36,Default,,0,0,0,,D.Y.
Dialogue: 0,0:00:32.83,0:00:36.77,Default,,0,0,0,,OHH OH NO OH NOOOO
Dialogue: 0,0:00:36.80,0:00:39.71,Default,,0,0,0,,EYY EYY EH
Dialogue: 0,0:00:41.21,0:00:45.68,Default,,0,0,0,,SI... SABES QUE YA LLEVO UN RATO MIRÁNDOTE
Dialogue: 0,0:00:46.48,0:00:49.75,Default,,0,0,0,,TENGO QUE BAILAR CONTIGO HOY
Dialogue: 0,0:00:50.85,0:00:51.85,Default,,0,0,0,,D.Y.
Dialogue: 0,0:00:51.85,0:00:57.22,Default,,0,0,0,,VI QUE TU MIRADA YA ESTABA LLAMÁNDOME
Dialogue: 0,0:00:57.26,0:01:00.83,Default,,0,0,0,,MUESTRAME EL CAMINO QUE YO VOY
Dialogue: 0,0:01:01.79,0:01:02.83,Default,,0,0,0,,OHH
Dialogue: 0,0:01:02.86,0:01:05.87,Default,,0,0,0,,TU... TÚ ERES EL IMÁN Y YO SOY EL METAL
Dialogue: 0,0:01:05.90,0:01:08.70,Default,,0,0,0,,ME VOY ACERCANDO Y VOY ARMANDO EL PLAN
Dialogue: 0,0:01:08.73,0:01:11.74,Default,,0,0,0,,SOLO CON PENSARLO SE ACELERA EL PULSO
Dialogue: 0,0:01:12.47,0:01:13.47,Default,,0,0,0,,OHH YEAH
Dialogue: 0,0:01:13.51,0:01:14.77,Default,,0,0,0,,YA...
Dialogue: 0,0:01:14.81,0:01:16.74,Default,,0,0,0,,YA ME ESTÁS GUSTANDO MÁS DE LO NORMAL
Dialogue: 0,0:01:16.78,0:01:19.31,Default,,0,0,0,,TODOS MIS SENTIDOS VAN PIDIENDO MÁS
Dialogue: 0,0:01:19.34,0:01:22.81,Default,,0,0,0,,ESTO HAY QUE TOMARLO SIN NINGÚN APURO...
Dialogue: 0,0:01:22.85,0:01:25.45,Default,,0,0,0,,DESPACITO
Dialogue: 0,0:01:25.48,0:01:27.89,Default,,0,0,0,,QUIERO RESPIRAR TU CUELLO DESPACITO
Dialogue: 0,0:01:27.92,0:01:30.72,Default,,0,0,0,,DEJA QUE TE DIGA COSAS AL OÍDO
Dialogue: 0,0:01:30.76,0:01:34.16,Default,,0,0,0,,PARA QUE TE ACUERDES SI NO ESTÁS CONMIGO
Dialogue: 0,0:01:34.19,0:01:36.26,Default,,0,0,0,,DESPACITO
Dialogue: 0,0:01:36.30,0:01:38.73,Default,,0,0,0,,QUIERO DESNUDARTE A BESOS, DESPACITO
Dialogue: 0,0:01:38.76,0:01:41.40,Default,,0,0,0,,FIRMAR LAS PAREDES DE TU LABERINTO
Dialogue: 0,0:01:41.43,0:01:44.17,Default,,0,0,0,,Y HACER DE TU CUERPO TODO UN MANUSCRITO
Dialogue: 0,0:01:44.20,0:01:46.31,Default,,0,0,0,,(SUBE SUBE SUBE) (SUBE SUBE)
Dialogue: 0,0:01:46.34,0:01:49.91,Default,,0,0,0,,QUIERO VER BAILAR TU PELO QUIERO SER TU RITMO
Dialogue: 0,0:01:49.94,0:01:52.81,Default,,0,0,0,,QUE LE ENSEÑES A MI BOCA
Dialogue: 0,0:01:52.84,0:01:55.41,Default,,0,0,0,,TUS LUGARES FAVORITOS
Dialogue: 0,0:01:55.45,0:01:57.18,Default,,0,0,0,,FAVORITO FAVORITO EY EEH
Dialogue: 0,0:01:57.22,0:01:58.52,Default,,0,0,0,,DÉJAME SOBREPASAR
Dialogue: 0,0:01:58.55,0:02:00.79,Default,,0,0,0,,TU ZONAS DE PELIGRO
Dialogue: 0,0:02:00.82,0:02:03.46,Default,,0,0,0,,HASTA PROVOCAR TUS GRITOS
Dialogue: 0,0:02:03.49,0:02:06.19,Default,,0,0,0,,Y QUE OLVIDES TU APELLIDO
Dialogue: 0,0:02:06.22,0:02:08.43,Default,,0,0,0,,SI TE PIDO UN BESO VEN DAMELO
Dialogue: 0,0:02:08.46,0:02:09.76,Default,,0,0,0,,YO SE QUE ESTAS PENSANDOLO
Dialogue: 0,0:02:09.79,0:02:11.20,Default,,0,0,0,,LLEVO TIEMPO INTENTANDOLO
Dialogue: 0,0:02:11.23,0:02:12.30,Default,,0,0,0,,MAMI ESTO ES DANDO Y DANDOLO
Dialogue: 0,0:02:12.33,0:02:15.27,Default,,0,0,0,,SABES QUE TU CORAZON CONMIGO TE HACE BAM BAM
Dialogue: 0,0:02:15.30,0:02:17.87,Default,,0,0,0,,SABES QUE ESA BEBA ESTA BUSCANDO DE MI BAMBAM
Dialogue: 0,0:02:17.90,0:02:20.54,Default,,0,0,0,,VEN PRUEBA DE MI BOCA PARA VER COMO TE SABE
Dialogue: 0,0:02:20.57,0:02:23.31,Default,,0,0,0,,QUIERO QUIERO QUIERO VER CUANTO AMOR A TI TE CABE
Dialogue: 0,0:02:23.34,0:02:25.95,Default,,0,0,0,,YO NO TENGO PRISA YO ME QUIERO DAR EL VIAJE
Dialogue: 0,0:02:25.98,0:02:28.58,Default,,0,0,0,,EMPEZAMOS LENTO DESPUES SALVAJE
Dialogue: 0,0:02:28.61,0:02:31.35,Default,,0,0,0,,PASITO A PASITO SUAVE SUAVECITO
Dialogue: 0,0:02:31.38,0:02:33.92,Default,,0,0,0,,NOS VAMOS PEGANDO POQUITO A POQUITO
Dialogue: 0,0:02:33.95,0:02:36.62,Default,,0,0,0,,CUANDO TU ME BESAS CON ESA DESTREZA
Dialogue: 0,0:02:36.66,0:02:39.53,Default,,0,0,0,,CREO TU ERES MALICIA CON DELICADEZA
Dialogue: 0,0:02:39.56,0:02:42.19,Default,,0,0,0,,PASITO A PASITO SUAVE SUAVECITO
Dialogue: 0,0:02:42.23,0:02:44.86,Default,,0,0,0,,NOS VAMOS PEGANDO POQUITO A POQUITO
Dialogue: 0,0:02:44.90,0:02:47.43,Default,,0,0,0,,Y ES QUE ESA BELLEZA ES UN ROMPE CABEZA
Dialogue: 0,0:02:47.47,0:02:51.27,Default,,0,0,0,,PERO PA MONTARLO AQUI TENGO LA PIEZA (OYEEE)
